# Core Service Configuration for Docker Compose Stack
# This file is mounted into the core-service container at /app/config.yaml
#
# Priority order (highest to lowest):
# 1. Environment variables (MUCGPT_CORE_* for top-level, MUCGPT_CORE_<SECTION>__<FIELD> for nested)
# 2. YAML configuration file (this file)
# 3. .env file
#
# YAML keys are lowercase. Legacy UPPERCASE YAML keys are ignored (legacy SSO
# keys fail startup validation) - migrate
# existing config files. Environment variable names stay UPPERCASE.
#
# SECURITY - secrets doctrine:
# Do NOT store real secrets (passwords, API keys, tokens) in this file.
# Config files are often mounted as ConfigMaps (leaking values into etcd) or get
# committed to Git. Provide secrets via environment variables instead - they
# always override YAML values. The demo values kept below exist only so the
# local docker-compose demo stack runs out of the box.
#
# Nested env vars use __ (double underscore) as delimiter, e.g. MUCGPT_CORE_REDIS__HOST

# General settings
version: "0.7.1"
log_config: "logconf.yaml"
ag_ui_enabled: false

# Frontend settings
env_name: "MUCGPT🦜"
alternative_logo: false
# Enables the browser-based speech-to-text feature. Transcription itself runs fully
# client-side (models are downloaded and cached by the browser; no audio reaches the backend).
transcription_enabled: false
# The single model id used for transcription by every user (must match an
# entry of the frontend's TRANSCRIPTION_MODELS list). There is no default —
# the feature stays disabled while this is unset. Recommended (runs entirely
# on WASM, no WebGPU needed): "istupakov/canary-180m-flash-onnx".
transcription_model: "istupakov/canary-180m-flash-onnx"
ai_act_compliance_check_enabled: true
# Canvas limits (characters); exposed to the frontend via /config
canvas_content_max_chars: 262144
canvas_editor_max_chars: 524288
app_version: "2.0"
frontend_version: "0.0.2"
assistant_version: "0.0.3"
release_notes:
  - version: "2.0.x"
    content: |
      ## AGI reached

      Pls don't tell anybody
owner_profile_url_template: "https://intranet.example.org/person/{uid}"  # {uid} is replaced with the owner ID

# Backend settings
unauthorized_user_redirect_url: "<your-url>"
ad2image_url: "<your-ad2image-url>"  # Base URL of the ad2image service for avatar images

# PostgreSQL persistence settings
db:
  host: "checkpoint-postgres"
  port: 5432
  name: "checkpoints"
  user: "admin"
  # Demo value for the local stack only (matches POSTGRES_PASSWORD in docker-compose.yml).
  # For real deployments provide it via MUCGPT_CORE_DB__PASSWORD instead of storing it here.
  password: "admin"

# Compliance cache settings
# If enabled, compliance check results are cached in Redis and can be verified by the assistant service.
compliance_cache_enabled: true
# Time-to-live for compliance cache entries in seconds (default: 30 minutes)
compliance_cache_ttl_seconds: 1800

# Parsing settings
parser_backend: "xberg"
xberg_url: "http://xberg-full:8000"
xberg_timeout: 120.0

# Langfuse is configured via the standard environment variables
# LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY and LANGFUSE_HOST; the Langfuse SDK
# reads them directly.
# WARNING: MUCGPT_CORE_LANGFUSE__* environment variables are NO LONGER read
# (silently ignored) - credentials must use the unprefixed standard
# LANGFUSE_* names.

# Prompt settings (optional - nested under prompts key)
# Configure prompt names exactly like the local Markdown files in
# mucgpt-core-service/app/agent/prompt_pool/, without the .md suffix.
# Langfuse is tried first; local prompt files are the compatibility fallback.
# prompts:
#   folders:
#     - name: "defaults"
#       prompts:
#         # General system instructions used for regular chat.
#         - name: "default_instructions"
#           label: "production"
#     - name: "generation_prompts"
#       prompts:
#         # Generates a concise title for a chat conversation.
#         - name: "chat_title"
#           label: "production"
#         # Generates a name for an assistant created from a prompt seed.
#         - name: "assistant_name"
#           label: "production"
#         # Generates an assistant description from a prompt seed.
#         - name: "assistant_description"
#           label: "production"
#         # Generates an assistant system prompt from a prompt seed.
#         - name: "assistant_systemprompt"
#           label: "production"
#     - name: "compliance_prompts"
#       prompts:
#         # Screens for high-risk migration, asylum, and border-control use cases.
#         - name: "migration_asylum_border"
#           label: "production"
#         # Screens for high-risk public-service access and benefit decisions.
#         - name: "public_services_access"
#           label: "production"
#         # Screens for high-risk employment and worker-management use cases.
#         - name: "hr_employment"
#           label: "production"
#         # Screens for high-risk education and vocational-training use cases.
#         - name: "education"
#           label: "production"

# MCP Settings (Model Context Protocol)
# Used by core service for external tool integration
# Users only see and select tool groups (group / tool_groups, default: the source id).
# Enabling a group enables all of its tools.
mcp:
  sources:
    "organization-docs":
      url: "http://mcpdoc-server:8088/sse"
      transport: "sse"
      forward_token: false
      group: "organization-docs"
      overrides:
        - name: "fetch_docs"
          description: "Loads information from a specific documentation URL. Always provide the complete URL."
        - name: "list_doc_sources"
          description: "Lists available documentation sources. Use fetch_docs to retrieve relevant content."
      # ...

    # Example for custom headers to authenticate with MCP server via litellm proxy
    # authentication with litellm via Bearer
    # authentication with mcp server via basic auth
    "mcp-name":
      url: "<your-mcp-url>"
      transport: "streamable_http"
      forward_token: true
      # Provide tokens/keys via environment variables or a secret manager instead
      # of storing them in this file (nested env overrides for keyed sources are
      # impractical; keep such sources in a protected config or inject via env).
      # forward_auth_override: "Basic <base64 encoded email:token>"
      # headers:
      #   x-litellm-api-key: "<your-api-key>"
      group: "name"
      # Example tool description overrides.
      overrides:
        - name: "tool-name"
          description: "detailed tool description"
          group: "extra group in ui"
        # ...
  cache_ttl: 123

# Providers configuration
# Connection settings (type/endpoint/api_key/api_version) live in this `providers`
# dict; model entries reference a provider via `provider: <key>`. Provider keys
# MUST be lowercase: env var name segments are lowercased, so uppercase keys
# would silently miss their env overrides.
# Unlike the old per-model api_key, api_key is now per provider and MUST be
# provided via environment variables (ProviderConfig requires api_key, so the
# stack fails settings validation without it). Set this in .env BEFORE the
# first start:
#   MUCGPT_CORE_PROVIDERS__MY_GATEWAY__API_KEY
# Do not store real API keys in this file - provide them via
# MUCGPT_CORE_PROVIDERS__<KEY>__API_KEY or protect this file accordingly.
providers:
  my_gateway:
    type: "openai"             # "openai" or "azure"
    endpoint: "https://your-litellm-gateway.example.org/"
    # Required: set MUCGPT_CORE_PROVIDERS__MY_GATEWAY__API_KEY in .env before the first start.
    # api_key: "<your-sk>"
    api_version: ""            # only needed for type "azure"

# Models configuration
# Configure your LLM models here instead of using the MUCGPT_CORE_MODELS
# environment variable (JSON array).
# Reasoning effort sent to reasoning models when neither the request nor the model's
# default_reasoning_effort sets one. Set to null to omit it and use the provider default.
fallback_reasoning_effort: "low"
models:
  - provider: "my_gateway"     # required reference into providers
    id: "gpt-4o"
    deployment: ""             # only needed for type "azure"
    deep_agent:
      # Built-in tools are disabled unless explicitly enabled for this model.
      enabled_builtin_tools: [
        "write_todos",
        "ls",
        "read_file",
        "write_file",
        "edit_file",
        "delete",
        "glob",
        "grep",
        "execute",
        "task",
        ]
      enable_summarization: true
      enable_subagents: false
    model_info:
      internal_task_model_strength: null  # Optional: "weak" for chat titles, "strong" for assistant drafts
      auto_enrich_from_model_info_endpoint: true
      max_output_tokens: 16384
      max_input_tokens: 128000
      display_name: "<human-readable name>"  # Optional: shown instead of id
      description: "<description>"
      short_description: "<one-line summary>"
      input_cost_per_token: 0.00000009
      output_cost_per_token: 0.00000036
      supports_reasoning: false
      # Optional, usually provided by LiteLLM model_info. Valid levels: none, minimal,
      # low, medium, high, max (e.g. privatemode.ai GLM models accept max). Requests are
      # clamped to the nearest supported effort; without a default, fallback_reasoning_effort applies.
      # supported_reasoning_efforts: [none, low, high, max]
      # default_reasoning_effort: max
      knowledge_cut_off: "2024-07-01"

# Additional models can be added here as list items; they reference a provider:
# - provider: "my_gateway"
#   id: "<another-model>"
#   deployment: ""             # only needed for type "azure"
#   model_info:
#     # ... model info ...

# SSO Settings (Keycloak)
# Used by both core and assistant services for authentication
sso:
  role: "mucgpt-user"
  admin_role: "mucgpt-admin"
  user_id_claim: "user_id"
  organization_unit_claim: "organization_unit"

# Redis Settings (Valkey in docker-compose)
# Used by both core and assistant services for caching
redis:
  host: "valkey"
  port: 6379
  username: "default"
  # Demo value for the local stack only (matches valkey in docker-compose.yml).
  # For real deployments provide it via MUCGPT_CORE_REDIS__PASSWORD instead of storing it here.
  password: "password"
