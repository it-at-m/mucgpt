{
  "$schema": "https://opencode.ai/config.json",

  // Centralize repo-specific guidance for agents
  "instructions": [
    "CLAUDE.md",
    "DESIGN.md",
    "README.md",
    "PRODUCT.md",
    "docs/GETTING_STARTED.md",
    "docs/DEVELOPMENT.md",
    "docs/FEATURES.md",
    "stack/README.md"
  ],

  // Advertise the monorepo structure in agent context so it picks the right area
  "references": {
    "core-service": {
      "path": "mucgpt-core-service",
      "description": "Python 3.13 FastAPI. LLM agent orchestration (LangGraph), tools, chat, parsing, server-side chat persistence."
    },
    "assistant-service": {
      "path": "mucgpt-assistant-service",
      "description": "Python 3.13 FastAPI. CRUD/sharing of assistants; LDAP; talks to Postgres."
    },
    "frontend": {
      "path": "mucgpt-frontend",
      "description": "React 19 + TypeScript + Vite, Fluent UI, i18next. MSW mocks in dev."
    },
    "stack": {
      "path": "stack",
      "description": "Podman/Docker Compose stack for full local environment."
    },
    "docs": {
      "path": "docs",
      "description": "Project docs: Getting Started, Development, Features."
    }
  },

  // Keep the watcher quiet on large/generated dirs
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/dist/**",
      "**/build/**",
      "**/.uv/**",
      "**/.pytest_cache/**",
      ".git/**"
    ]
  }

  // Optional guardrails (enable if desired)
  // "permission": { "bash": "ask", "edit": "ask" }
}
