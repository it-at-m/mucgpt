# Core Service Configuration
# This file provides an example YAML configuration for the MUCGPT core service.
# You can use this instead of environment variables or base64 encoded JSON.
#
# Priority order (highest to lowest):
# 1. Environment variables (MUCGPT_CORE_* for top-level, MUCGPT_CORE_<SECTION>__<FIELD> for nested)
# 2. YAML configuration file (this file, when named config.yaml)
# 3. .env file
#
# Note: Because case_sensitive=False in settings, use UPPERCASE field names in YAML
# Nested env vars use __ (double underscore) as delimiter, e.g. MUCGPT_CORE_REDIS__HOST

# General settings
VERSION: "0.0.1"
LOG_CONFIG: "logconf.yaml"

# Frontend settings
ENV_NAME: "MUCGPT"
ALTERNATIVE_LOGO: false
TRANSCRIPTION_ENABLED: false
AI_ACT_COMPLIANCE_CHECK_ENABLED: true
FRONTEND_VERSION: "unknown"
ASSISTANT_VERSION: "unknown"
FOOTER_LINK_URL: "https://ki.muenchen.de"
FOOTER_LABEL: "DAICE"
FAQ_URL: "https://ki.muenchen.de/"
INCIDENT_REPORT_URL: "https://ki.muenchen.de/"
FEATURE_REQUEST_URL: "https://ki.muenchen.de/"
CONTACT_MAIL_URL: "mailto:ki@muenchen.de"
AD2IMAGE_URL: "http://localhost:8084"  # Base URL of the ad2image service

# Backend settings
UNAUTHORIZED_USER_REDIRECT_URL: ""

# Compliance cache settings
# If enabled, compliance check results are cached in Redis and can be verified by the assistant service.
COMPLIANCE_CACHE_ENABLED: true
# Time-to-live for compliance cache entries in seconds (default: 30 minutes)
COMPLIANCE_CACHE_TTL_SECONDS: 1800

# Models configuration
# Instead of base64 encoded JSON in environment variables, you can configure models here
MODELS:
  - type: "OPENAI"
    llm_name: "<your-llm-name>"
    deployment: ""
    endpoint: "<your-endpoint>"
    api_key: "<your-sk>"
    api_version: ""
    deep_agent:
      # Built-in tools are disabled unless explicitly enabled for this model.
      enabled_builtin_tools: ["write_todos", ...]
      enable_summarization: true
      enable_subagents: false
    model_info:
      auto_enrich_from_model_info_endpoint: true
      max_output_tokens: 16384
      max_input_tokens: 128000
      description: "<description>"
      internal_task_model_strength: null  # Optional: "weak" for chat titles, "strong" for assistant drafts
      input_cost_per_token: 0.00000009
      output_cost_per_token: 0.00000036
      supports_function_calling: true
      supports_reasoning: false
      supports_vision: true
      litellm_provider: "<provider>"
      inference_location: "<region>"
      knowledge_cut_off: "2024-07-01"

# SSO Settings (optional - nested under SSO key)
SSO:
  ROLE: "lhm-ab-mucgpt-user"
  # ADMIN_ROLE / USE_ROLE_RESTRICTION are reserved for future admin
  # functionality and don't affect basic access today.
  # ADMIN_ROLE: "lhm-ab-mucgpt-admin"

# Langfuse Settings (optional - nested under LANGFUSE key)
LANGFUSE:
  PUBLIC_KEY: "<your-public-key>"
  SECRET_KEY: "<your-secret-key>"
  HOST: "https://langfuse.example.com"

# MCP Settings (optional - nested under MCP key)
MCP:
  SOURCES:
    "ki in muenchen":
      url: "http://localhost:8088/sse"
      transport: "sse"
      # group: "jira"  # optional: all tools from this server get this group in the frontend
      # tool_groups:   # optional: fine-grained grouping by tool name prefix (overrides group)
      #   "jira__": "jira"
      #   "confluence_": "confluence"
      # descriptions:  # optional: overrides for tool descriptions
      #   - name: "searchConfluenceUsingCql"
      #     description: "Search Confluence content using CQL queries. Use for structured or advanced filtering."
  CACHE_TTL: 43200

# Internet Search Settings (optional - backed by SearXNG)
# Configure this to enable the InternetSearch tool.
# Override via environment variables, e.g.:
#   MUCGPT_CORE_INTERNET_SEARCH__SEARXNG_URL=https://your-searxng-instance/
# INTERNET_SEARCH:
#   SEARXNG_URL: "https://your-searxng-instance/"
#   TIMEOUT: 10.0
#   MAX_RESULTS: 5
#   LANGUAGE: "de"
#   SAFESEARCH: 1

# Redis Settings (optional - nested under REDIS key)
# Override individual fields via environment variables, e.g.:
#   MUCGPT_CORE_REDIS__HOST=my-redis
#   MUCGPT_CORE_REDIS__PORT=6379
#   MUCGPT_CORE_REDIS__USERNAME=default
#   MUCGPT_CORE_REDIS__PASSWORD=secret
REDIS:
  HOST: "localhost"
  PORT: 6379
  USERNAME: "default"
  PASSWORD: "<your-password>"
