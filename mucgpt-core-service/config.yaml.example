# Core Service Configuration
# This file provides an example YAML configuration for the MUCGPT core service.
# You can use this instead of environment variables (e.g. MUCGPT_CORE_MODELS as a
# JSON array for models).
#
# Priority order (highest to lowest):
# 1. Environment variables (MUCGPT_CORE_* for top-level, MUCGPT_CORE_<SECTION>__<FIELD> for nested)
# 2. YAML configuration file (this file, when named config.yaml)
# 3. .env file
#
# YAML keys are lowercase. Legacy UPPERCASE YAML keys are ignored - migrate
# existing config files. Environment variable names stay UPPERCASE.
#
# SECURITY - secrets doctrine:
# Do NOT store real secrets (passwords, API keys, tokens) in this file.
# Config files are often mounted as ConfigMaps (leaking values into etcd) or get
# committed to Git. Provide secrets via environment variables instead - they
# always override YAML values (priority 1 above). Secret-bearing fields below are
# commented out and name the matching environment variable.
#
# Nested env vars use __ (double underscore) as delimiter, e.g. MUCGPT_CORE_REDIS__HOST

# General settings
version: "0.0.1"
log_config: "logconf.yaml"

# Frontend settings
env_name: "MUCGPT"
alternative_logo: false
# Enables the browser-based speech-to-text feature. Transcription itself runs fully
# client-side (models are downloaded and cached by the browser; no audio reaches the backend).
transcription_enabled: false
# Model id preselected in the transcription settings for first-time users (must match an
# entry of the frontend's TRANSCRIPTION_MODELS list, e.g. "onnx-community/whisper-small").
# Unknown ids are ignored; leave unset for the frontend's built-in default.
transcription_default_model: null
ai_act_compliance_check_enabled: true
frontend_version: "unknown"
assistant_version: "unknown"
footer_link_url: ""
footer_label: ""
faq_url: ""
incident_report_url: ""
feature_request_url: ""
contact_mail_url: ""
ad2image_url: "http://localhost:8084"  # Base URL of the ad2image service
owner_profile_url_template: "https://intranet.example.org/person/{uid}"  # {uid} is replaced with the owner ID


# Backend settings
unauthorized_user_redirect_url: ""

# Compliance cache settings
# If enabled, compliance check results are cached in Redis and can be verified by the assistant service.
compliance_cache_enabled: true
# Time-to-live for compliance cache entries in seconds (default: 30 minutes)
compliance_cache_ttl_seconds: 1800

# Providers configuration
# Connection settings (type/endpoint/api_key/api_version) live in this `providers`
# dict; model entries reference a provider via `provider: <key>`. Provider keys
# MUST be lowercase: env var name segments are lowercased, so uppercase keys
# would silently miss their env overrides.
# Unlike the old per-model api_key, api_key is now per provider and CAN be
# overridden via environment variables, e.g.:
#   MUCGPT_CORE_PROVIDERS__MY_GATEWAY__API_KEY
providers:
  my_gateway:
    type: "openai"             # "openai" or "azure"
    endpoint: "https://your-litellm-gateway.example.org/"
    # Provide via environment variable MUCGPT_CORE_PROVIDERS__MY_GATEWAY__API_KEY instead of storing it here.
    # api_key: "<your-sk>"
    api_version: ""            # only needed for type "azure"

# Models configuration
# Instead of base64 encoded JSON in environment variables, you can configure models here
# Reasoning effort sent to reasoning models when neither the request nor the model's
# default_reasoning_effort sets one. Set to null to omit it and use the provider default.
fallback_reasoning_effort: "low"
models:
  - provider: "my_gateway"     # required reference into providers
    llm_name: "gpt-4o"
    deployment: ""             # only needed for type "azure"
    deep_agent:
      # Built-in tools are disabled unless explicitly enabled for this model.
      enabled_builtin_tools: [
        "write_todos",
        "ls",
        "read_file",
        "write_file",
        "edit_file",
        "delete",
        "glob",
        "grep",
        "execute",
        "task",
        ]
      enable_summarization: true
      enable_subagents: false
    model_info:
      auto_enrich_from_model_info_endpoint: true
      max_output_tokens: 16384
      max_input_tokens: 128000
      context_warning_threshold_percent: 75
      context_critical_threshold_percent: 90
      display_name: "<human-readable name>"  # Optional: shown instead of llm_name
      description: "<description>"
      short_description: "<one-line summary>"
      internal_task_model_strength: null  # Optional: "weak" for chat titles, "strong" for assistant drafts
      input_cost_per_token: 0.00000009
      output_cost_per_token: 0.00000036
      supports_reasoning: false
      # Optional, usually provided by LiteLLM model_info. Requests are clamped to the
      # nearest supported effort; without a default, fallback_reasoning_effort applies.
      # supported_reasoning_efforts: [low, medium, high]
      # default_reasoning_effort: low
      # Defaults to true. Set false for models that reject temperature (e.g. GPT-5/GPT-6).
      # This explicit setting controls filtering; model names/profiles are not consulted.
      supports_temperature: true
      knowledge_cut_off: "2024-07-01"

# SSO Settings (optional - nested under sso key)
sso:
  role: "mucgpt-user"
  admin_role: "mucgpt-admin"
  user_id_claim: "user_id"
  organization_unit_claim: "organization_unit"

# Langfuse is configured via the standard environment variables
# LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY and LANGFUSE_HOST; the Langfuse SDK
# reads them directly.
# WARNING: MUCGPT_CORE_LANGFUSE__* environment variables are NO LONGER read
# (silently ignored) - credentials must use the unprefixed standard
# LANGFUSE_* names.

# Prompt settings (optional - nested under prompts key)
# Configure prompt names exactly like the local Markdown files in
# app/agent/prompt_pool/, without the .md suffix. Langfuse is used first;
# when it is unavailable or a fetch fails, the matching local file is used.
# prompts:
#   folders:
#     - name: "defaults"
#       prompts:
#         # General system instructions used for regular chat.
#         - name: "default_instructions"
#           label: "production"
#     - name: "generation_prompts"
#       prompts:
#         # Generates a concise title for a chat conversation.
#         - name: "chat_title"
#           label: "production"
#         # Generates a name for an assistant created from a prompt seed.
#         - name: "assistant_name"
#           label: "production"
#         # Generates an assistant description from a prompt seed.
#         - name: "assistant_description"
#           label: "production"
#         # Generates an assistant system prompt from a prompt seed.
#         - name: "assistant_systemprompt"
#           label: "production"
#     - name: "compliance_prompts"
#       prompts:
#         # Screens for high-risk migration, asylum, and border-control use cases.
#         - name: "migration_asylum_border"
#           label: "production"
#         # Screens for high-risk public-service access and benefit decisions.
#         - name: "public_services_access"
#           label: "production"
#         # Screens for high-risk employment and worker-management use cases.
#         - name: "hr_employment"
#           label: "production"
#         # Screens for high-risk education and vocational-training use cases.
#         - name: "education"
#           label: "production"

# MCP Settings (optional - nested under mcp key)
mcp:
  sources:
    "ki in muenchen":
      url: "http://localhost:8088/sse"
      transport: "sse"
      # group: "jira"  # optional: all tools from this server get this group in the frontend
      # tool_groups:   # optional: fine-grained grouping by tool name prefix (overrides group)
      #   "jira__": "jira"
      #   "confluence_": "confluence"
      # descriptions:  # optional: overrides for tool descriptions
      #   - name: "searchConfluenceUsingCql"
      #     description: "Search Confluence content using CQL queries. Use for structured or advanced filtering."
  cache_ttl: 43200

# Internet Search Settings (optional - backed by SearXNG)
# Configure this to enable the InternetSearch tool.
# Override via environment variables, e.g.:
#   MUCGPT_CORE_INTERNET_SEARCH__SEARXNG_URL=https://your-searxng-instance/
# internet_search:
#   searxng_url: "https://your-searxng-instance/"
#   timeout: 10.0
#   max_results: 5
#   language: "de"
#   safesearch: 1

# Redis Settings (optional - nested under redis key)
# Override individual fields via environment variables, e.g.:
#   MUCGPT_CORE_REDIS__HOST=my-redis
#   MUCGPT_CORE_REDIS__PORT=6379
#   MUCGPT_CORE_REDIS__USERNAME=default
#   MUCGPT_CORE_REDIS__PASSWORD=secret
redis:
  host: "localhost"
  port: 6379
  username: "default"
  # Provide via environment variable MUCGPT_CORE_REDIS__PASSWORD instead of storing it here.
  # password: "<your-password>"
